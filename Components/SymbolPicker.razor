<section class="flow-panel hud-panel targeting-panel" aria-labelledby="symbol-picker-title">
    <h1 id="symbol-picker-title">
        <span lang="en">Choose a covered position</span>
        <span lang="my">ဖုံးထားသော နေရာတစ်ခု ရွေးပါ</span>
    </h1>

    <div class="selected-question">
        <p class="label-text">
            <span lang="en">Your question</span>
            <span lang="my">သင်၏မေးခွန်း</span>
        </p>
        <p lang="my">@Question.Text</p>
    </div>

    <p class="lede">
        <span lang="en">Choose the position that first catches your attention.</span>
        <span lang="my">ပထမဆုံး စိတ်ဝင်စားမိသော နေရာကို ရွေးပါ။</span>
    </p>

    <div class="symbol-grid symbol-grid--covered" role="group" aria-label="Covered symbol choices / ဖုံးထားသော သင်္ကေတရွေးချယ်စရာများ">
        @foreach (var item in Symbols.Select((symbol, index) => (symbol, index)))
        {
            var position = item.index + 1;
            <button type="button"
                    class="covered-symbol"
                    aria-label="Choose position @position / နေရာ @position ကို ရွေးမည်"
                    @key="item.symbol.Id"
                    @onclick="() => SymbolSelected.InvokeAsync(item.symbol)">
                <span aria-hidden="true">?</span>
                <span class="position-number" aria-hidden="true">@position</span>
            </button>
        }
    </div>

</section>

@code {
    [Parameter, EditorRequired]
    public NatMyatSiQuestion Question { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<DivinationSymbol> Symbols { get; set; } = [];

    [Parameter]
    public EventCallback<DivinationSymbol> SymbolSelected { get; set; }

}
