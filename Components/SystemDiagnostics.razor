<aside class="diagnostics-panel" aria-label="System diagnostics / စနစ်စစ်ဆေးမှု">
    <details open>
        <summary>
            <span class="summary-marker" aria-hidden="true"></span>
            <span>
                <span lang="en">System diagnostics</span>
                <span lang="my">စနစ်စစ်ဆေးမှု</span>
            </span>
            <span class="diagnostic-state">ONLINE</span>
        </summary>

        <div class="diagnostic-content">
            <div class="mode-readout">
                <span class="label-text">CURRENT MODE / လက်ရှိအခြေအနေ</span>
                <strong>@Mode</strong>
                <span>PHASE @CurrentStep.ToString("00")</span>
            </div>

            <dl class="module-status-list">
                <div>
                    <dt>QUERY ARCHIVE</dt>
                    <dd><span>READY</span><strong>100</strong></dd>
                </div>
                <div>
                    <dt>TARGET MATRIX</dt>
                    <dd><span>@TargetState</span><strong>16</strong></dd>
                </div>
                <div>
                    <dt>READING CORE</dt>
                    <dd><span>LOCAL</span><strong>1600</strong></dd>
                </div>
            </dl>

            <div class="node-monitor">
                <div class="node-monitor-heading">
                    <span>NODE MAP</span>
                    <span>4 × 4</span>
                </div>
                <div class="mini-node-map" aria-hidden="true">
                    @foreach (var nodePosition in Enumerable.Range(1, 16))
                    {
                        <span class="@GetNodeClass(nodePosition)" @key="nodePosition"></span>
                    }
                </div>
                <p class="node-monitor-status" aria-live="polite">
                    @if (SelectedPosition is int position)
                    {
                        <span lang="en">Target @position locked</span>
                        <span lang="my">ပစ်မှတ် @position ကို ရွေးထားသည်</span>
                    }
                    else
                    {
                        <span lang="en">Awaiting target lock</span>
                        <span lang="my">ပစ်မှတ်ရွေးချယ်မှုကို စောင့်နေသည်</span>
                    }
                </p>
            </div>

            <div class="telemetry-row" aria-label="Local runtime telemetry">
                <span>NET <strong>0</strong></span>
                <span>DATA <strong>LOCAL</strong></span>
                <span>HEALTH <strong>100%</strong></span>
            </div>

            <button type="button"
                    class="sound-toggle"
                    aria-pressed="@(SoundEnabled ? "true" : "false")"
                    @onclick="SoundToggle">
                <span class="sound-indicator" aria-hidden="true"></span>
                <span>
                    <span lang="en">Interface sound: @(SoundEnabled ? "on" : "off")</span>
                    <span lang="my">အသံ: @(SoundEnabled ? "ဖွင့်" : "ပိတ်")</span>
                </span>
            </button>
        </div>
    </details>
</aside>

@code {
    [Parameter]
    public int CurrentStep { get; set; }

    [Parameter, EditorRequired]
    public string Mode { get; set; } = string.Empty;

    [Parameter]
    public int? SelectedPosition { get; set; }

    [Parameter]
    public bool SoundEnabled { get; set; }

    [Parameter]
    public EventCallback SoundToggle { get; set; }

    private string TargetState => SelectedPosition.HasValue
        ? "LOCKED"
        : CurrentStep >= 2
            ? "ARMED"
            : "STANDBY";

    private string GetNodeClass(int position) => position == SelectedPosition
        ? "mini-node is-selected"
        : "mini-node";
}
