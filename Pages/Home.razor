@page "/"

<PageTitle>NatMyatSi — နတ်မျက်စိ</PageTitle>

<a class="skip-link" href="#main-content">
    <span lang="en">Skip to main content</span>
    <span lang="my">အဓိကအကြောင်းအရာသို့ ကျော်သွားရန်</span>
</a>

<div class="app-shell">
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="NatMyatSi home / နတ်မျက်စိ မူလစာမျက်နှာ">
            <span lang="en">NatMyatSi</span>
            <span lang="my">နတ်မျက်စိ</span>
        </a>
        <p>
            <span lang="en">A quiet space for reflection</span>
            <span lang="my">အေးချမ်းစွာ စဉ်းစားဆင်ခြင်ရန် နေရာ</span>
        </p>
    </header>

    <main id="main-content" class="main-content" tabindex="-1" @ref="mainContent">
        <p class="screen-reader-only" aria-live="polite" aria-atomic="true">@statusAnnouncement</p>

        @if (CurrentProgressStep > 0)
        {
            <nav class="progress" aria-label="Reading progress / ဟောစာတမ်း လုပ်ငန်းစဉ်">
                <ol>
                    @foreach (var step in ProgressSteps)
                    {
                        <li class="@(step.Number <= CurrentProgressStep ? "is-reached" : null)"
                            aria-current="@(step.Number == CurrentProgressStep ? "step" : null)"
                            @key="step.Number">
                            <span class="progress-number" aria-hidden="true">@step.Number</span>
                            <span>
                                <span lang="en">@step.English</span>
                                <span lang="my">@step.Myanmar</span>
                            </span>
                        </li>
                    }
                </ol>
            </nav>
        }

        @if (isLoading)
        {
            <section class="flow-panel loading-state" aria-labelledby="loading-title" aria-busy="true">
                <p class="eyebrow">NatMyatSi · နတ်မျက်စိ</p>
                <h1 id="loading-title">
                    <span lang="en">Preparing your questions</span>
                    <span lang="my">မေးခွန်းများ ပြင်ဆင်နေသည်</span>
                </h1>
                <p>
                    <span lang="en">Loading the local reading catalog…</span>
                    <span lang="my">အက်ပ်အတွင်းရှိ ဟောစာတမ်းအချက်အလက်များကို ဖတ်နေသည်…</span>
                </p>
            </section>
        }
        else if (loadError is not null)
        {
            <section class="flow-panel error-state" aria-labelledby="load-error-title" role="alert">
                <p class="eyebrow">
                    <span lang="en">Unable to continue</span>
                    <span lang="my">ဆက်လက်လုပ်ဆောင်၍ မရပါ</span>
                </p>
                <h1 id="load-error-title">
                    <span lang="en">The reading data could not be loaded</span>
                    <span lang="my">ဟောစာတမ်းအချက်အလက်များကို ဖတ်၍မရပါ</span>
                </h1>
                <p>
                    <span lang="en">Refresh the local data and try again.</span>
                    <span lang="my">အက်ပ်အတွင်းရှိ အချက်အလက်များကို ပြန်ဖတ်ရန် ထပ်မံကြိုးစားပါ။</span>
                </p>
                <button type="button" class="primary-action" @onclick="LoadCatalogAsync">
                    <span lang="en">Try again</span>
                    <span lang="my">ထပ်မံကြိုးစားမည်</span>
                </button>
            </section>
        }
        else
        {
            @switch (stage)
            {
                case WorkflowStage.Welcome:
                    <section class="flow-panel welcome-panel" aria-labelledby="welcome-title">
                        <p class="eyebrow">
                            <span lang="en">100 questions · 16 symbols</span>
                            <span lang="my">မေးခွန်း ၁၀၀ · သင်္ကေတ ၁၆ ခု</span>
                        </p>
                        <h1 id="welcome-title">
                            <span lang="en">Pause. Ask. Choose.</span>
                            <span lang="my">ခဏနားပါ။ မေးပါ။ ရွေးပါ။</span>
                        </h1>
                        <p class="lede">
                            <span lang="en">Choose a question, remember the shuffled symbols, then reveal one reading from the position that draws you.</span>
                            <span lang="my">မေးခွန်းတစ်ခုရွေးပါ၊ ရောမွှေထားသော သင်္ကေတများကို မှတ်သားပါ၊ ထို့နောက် စိတ်ဝင်စားမိသော နေရာမှ ဟောစာတမ်းတစ်ခုကို ဖော်ထုတ်ပါ။</span>
                        </p>

                        <ol class="flow-summary">
                            <li>
                                <span class="summary-number" aria-hidden="true">1</span>
                                <span><span lang="en">Choose a question</span><span lang="my">မေးခွန်းရွေးပါ</span></span>
                            </li>
                            <li>
                                <span class="summary-number" aria-hidden="true">2</span>
                                <span><span lang="en">Remember the symbols</span><span lang="my">သင်္ကေတများ မှတ်သားပါ</span></span>
                            </li>
                            <li>
                                <span class="summary-number" aria-hidden="true">3</span>
                                <span><span lang="en">Choose a covered position</span><span lang="my">ဖုံးထားသော နေရာကို ရွေးပါ</span></span>
                            </li>
                            <li>
                                <span class="summary-number" aria-hidden="true">4</span>
                                <span><span lang="en">Read and reflect</span><span lang="my">ဖတ်ရှုပြီး စဉ်းစားပါ</span></span>
                            </li>
                        </ol>

                        <aside class="reflection-note" aria-label="Important note / အရေးကြီးမှတ်ချက်">
                            <p lang="en">For reflection and entertainment only. It is not professional advice or a guaranteed prediction.</p>
                            <p lang="my">စဉ်းစားဆင်ခြင်ရန်နှင့် ဖျော်ဖြေရန်အတွက်သာ ဖြစ်ပါသည်။ ကျွမ်းကျင်ပညာရှင်၏ အကြံဉာဏ် သို့မဟုတ် အတည်ပြုခန့်မှန်းချက် မဟုတ်ပါ။</p>
                        </aside>

                        <button type="button" class="primary-action" @onclick="StartReading">
                            <span lang="en">Begin a reading</span>
                            <span lang="my">ဟောစာတမ်း စတင်မည်</span>
                        </button>
                    </section>
                    break;

                case WorkflowStage.Question:
                    <QuestionPicker Questions="catalog!.Questions" QuestionSelected="SelectQuestion" />
                    break;

                case WorkflowStage.Preview:
                    <SymbolPreview Question="selectedQuestion!"
                                   Symbols="shuffledSymbols"
                                   OnCover="CoverSymbols"
                                   OnChooseAnotherQuestion="ChooseAnotherQuestion" />
                    break;

                case WorkflowStage.Selection:
                    <SymbolPicker Question="selectedQuestion!"
                                  Symbols="shuffledSymbols"
                                  SymbolSelected="RevealReading"
                                  OnShowSymbolsAgain="ShowSymbolsAgain" />
                    break;

                case WorkflowStage.Result:
                    <ReadingResult Question="selectedQuestion!"
                                   Symbol="selectedSymbol!"
                                   Reading="selectedReading!"
                                   OnAskAnotherQuestion="ChooseAnotherQuestion"
                                   OnTrySameQuestion="TrySameQuestion" />
                    break;
            }
        }
    </main>

    <footer class="site-footer">
        <p>
            <span lang="en">Private by design: no account and no submitted question.</span>
            <span lang="my">ကိုယ်ရေးအချက်အလက်ကို ဦးစားပေးထားသည် — အကောင့်နှင့် ပေးပို့သောမေးခွန်း မရှိပါ။</span>
        </p>
    </footer>
</div>
