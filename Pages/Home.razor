@page "/"

<PageTitle>NatMyatSi — နတ်မျက်စိ</PageTitle>

<a class="skip-link" href="#main-content">
    <span lang="en">Skip to main content</span>
    <span lang="my">အဓိကအကြောင်းအရာသို့ ကျော်သွားရန်</span>
</a>

<div class="app-shell">
    <div class="viewport-frame" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
    </div>
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="NatMyatSi home / နတ်မျက်စိ မူလစာမျက်နှာ">
            <span lang="en">NatMyatSi</span>
            <span lang="my">နတ်မျက်စိ</span>
        </a>
        <button type="button"
                class="sound-toggle header-sound-toggle"
                aria-pressed="@(soundEnabled ? "true" : "false")"
                @onclick="ToggleSoundAsync">
            <span class="sound-indicator" aria-hidden="true"></span>
            <span>
                <span lang="en">Sound @(soundEnabled ? "on" : "off")</span>
                <span lang="my">အသံ @(soundEnabled ? "ဖွင့်" : "ပိတ်")</span>
            </span>
        </button>
    </header>

    <main id="main-content" class="main-content" tabindex="-1" @ref="mainContent">
        <p class="screen-reader-only" aria-live="polite" aria-atomic="true">@statusAnnouncement</p>

        <div class="hud-workspace">
            <div class="hud-primary">

        @if (CurrentProgressStep > 0)
        {
            <nav class="progress hud-progress" aria-label="Reading progress / ဟောစာတမ်း လုပ်ငန်းစဉ်">
                <ol>
                    @foreach (var step in ProgressSteps)
                    {
                        <li class="@(step.Number <= CurrentProgressStep ? "is-reached" : null)"
                            aria-current="@(step.Number == CurrentProgressStep ? "step" : null)"
                            @key="step.Number">
                            <span class="progress-number" aria-hidden="true">@step.Number</span>
                            <span>
                                <span lang="en">@step.English</span>
                                <span lang="my">@step.Myanmar</span>
                            </span>
                        </li>
                    }
                </ol>
            </nav>
        }

        @if (isLoading)
        {
            <section class="flow-panel hud-panel loading-state" aria-labelledby="loading-title" aria-busy="true">
                <h1 id="loading-title">
                    <span lang="en">Getting things ready</span>
                    <span lang="my">အဆင်သင့် ပြင်ဆင်နေသည်</span>
                </h1>
            </section>
        }
        else if (loadError is not null)
        {
            <section class="flow-panel hud-panel error-state" aria-labelledby="load-error-title" role="alert">
                <h1 id="load-error-title">
                    <span lang="en">NatMyatSi could not start</span>
                    <span lang="my">နတ်မျက်စိကို စတင်၍ မရပါ</span>
                </h1>
                <p>
                    <span lang="en">Try again. If the problem continues, reload the page.</span>
                    <span lang="my">ထပ်မံကြိုးစားပါ။ မရသေးပါက စာမျက်နှာကို ပြန်ဖွင့်ပါ။</span>
                </p>
                <button type="button" class="primary-action" @onclick="LoadCatalogAsync">
                    <span lang="en">Try again</span>
                    <span lang="my">ထပ်မံကြိုးစားမည်</span>
                </button>
            </section>
        }
        else
        {
            @switch (stage)
            {
                case WorkflowStage.Welcome:
                    <section class="flow-panel hud-panel welcome-panel" aria-labelledby="welcome-title">
                        <h1 id="welcome-title">
                            <span lang="en">Choose a question and reveal a reading</span>
                            <span lang="my">မေးခွန်းရွေးပြီး ဟောစာတမ်းဖော်ထုတ်ပါ</span>
                        </h1>
                        <p class="lede">
                            <span lang="en">Choose a question, then choose one spot to see its reading.</span>
                            <span lang="my">မေးခွန်းတစ်ခုရွေးပြီး နေရာတစ်ခုကို ရွေးကာ ဟောစာတမ်းကို ကြည့်ပါ။</span>
                        </p>

                        <aside class="reflection-note" aria-label="Important note / အရေးကြီးမှတ်ချက်">
                            <p lang="en">For reflection and entertainment only. It is not professional advice or a guaranteed prediction.</p>
                            <p lang="my">စဉ်းစားဆင်ခြင်ရန်နှင့် ဖျော်ဖြေရန်အတွက်သာ ဖြစ်ပါသည်။ ကျွမ်းကျင်ပညာရှင်၏ အကြံဉာဏ် သို့မဟုတ် အတည်ပြုခန့်မှန်းချက် မဟုတ်ပါ။</p>
                        </aside>

                        <button type="button" class="primary-action" @onclick="StartReading">
                            <span lang="en">Choose a question</span>
                            <span lang="my">မေးခွန်း ရွေးမည်</span>
                        </button>
                    </section>
                    break;

                case WorkflowStage.Question:
                    <QuestionPicker Questions="catalog!.Questions" QuestionSelected="SelectQuestion" />
                    break;

                case WorkflowStage.Selection:
                    <SymbolPicker Question="selectedQuestion!"
                                  Symbols="shuffledSymbols"
                                  SymbolSelected="RevealReading" />
                    break;

                case WorkflowStage.Result:
                    <ReadingResult Question="selectedQuestion!"
                                   Symbol="selectedSymbol!"
                                   Reading="selectedReading!"
                                   OnAskAnotherQuestion="ChooseAnotherQuestion"
                                   OnTrySameQuestion="TrySameQuestion" />
                    break;
            }
        }
            </div>

        </div>
    </main>

    <footer class="site-footer">
        <p>
            <span lang="en">No account. Nothing is sent.</span>
            <span lang="my">အကောင့်မလိုပါ။ ဘာမှ ပေးပို့မထားပါ။</span>
        </p>
    </footer>
</div>
