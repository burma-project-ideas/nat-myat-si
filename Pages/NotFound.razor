@page "/not-found"
@layout MainLayout

<PageTitle>Page not found — စာမျက်နှာမတွေ့ပါ</PageTitle>

<main class="main-content not-found" id="main-content">
    <section class="flow-panel" aria-labelledby="not-found-title">
        <p class="eyebrow">404</p>
        <h1 id="not-found-title">
            <span lang="en">Page not found</span>
            <span lang="my">စာမျက်နှာမတွေ့ပါ</span>
        </h1>
        <p>
            <span lang="en">The page you requested does not exist.</span>
            <span lang="my">သင်တောင်းဆိုသော စာမျက်နှာ မရှိပါ။</span>
        </p>
        <a class="primary-action" href="/">
            <span lang="en">Return home</span>
            <span lang="my">မူလစာမျက်နှာသို့ ပြန်မည်</span>
        </a>
    </section>
</main>
